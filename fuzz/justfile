# Hydration fuzzing v2 — see README.md for the full runbook. `just --list` for targets.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# Environment every cargo/ziggy call needs (MAKEFLAGS breaks AFL++'s make, wasm build is useless here,
# RocksDB needs cstdint on GCC>=13).
env := "env -u MAKEFLAGS SKIP_WASM_BUILD=1 CXXFLAGS=-include\\ cstdint"
# Only the AFL target carries LLVM coverage counters (one binary for fuzzing and `just cover`);
# the soak/snapshot binaries must not, or every replay drops a .profraw file.
# LLVM_PROFILE_FILE=/dev/null: build scripts/proc-macros get instrumented too and would drop a .profraw into
# every package dir of ../../hydration-node on each build.
afl_build_env := env + " RUSTFLAGS=-Cinstrument-coverage LLVM_PROFILE_FILE=/dev/null"
afl_env := "AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1 AFL_SKIP_CPUFREQ=1 LLVM_PROFILE_FILE=/dev/null"
noprof := "LLVM_PROFILE_FILE=/dev/null"

# Oracle/known-finding defaults for fuzz runs; override per invocation, e.g. `just known='' fuzz`.
known := "Transfer - source sent incorrect amount|Transfer - dest received incorrect amount|VIOLATION[accounting] 1001->222|VIOLATION[router_leftover]"
fuzz_env := "FUZZ_KNOWN_PANICS='" + known + "' FUZZ_ORACLE_DIFFERENTIAL=0 FUZZ_MAX_BLOCK_MS=20000"

out := "targets/runtime/output/hydration-fuzz-runtime"
# Scrape mode: "" = whole mainnet state (default; ~1.4 GB RAM per AFL instance, consistent intents/positions);
# "--slim" drops ordinary user accounts (~180 MB per instance, but reserves/positions of dropped users are gone).
slim := ""

# One-time: fuzzing tools + AFL++ runtime for the pinned nightly
setup:
    cargo install --locked ziggy@1.2.1 cargo-afl@0.18.2 grcov
    rustup component add llvm-tools-preview
    env -u MAKEFLAGS cargo afl config --build --force

# Soak runner + snapshot tool (release)
build:
    {{env}} cargo build --release

# AFL target (AFL + coverage instrumented); ~2 h cold, minutes incremental
build-afl:
    cd targets/runtime && {{afl_build_env}} cargo ziggy build --no-honggfuzz --release

# Scrape current mainnet state (slim: protocol/pool/contract accounts, all pallets) -> data/scrape/SNAPSHOT.
# `just scrape 0x<block hash>` pins a block (recommended: reproducible); default = latest finalized.
# Builds the node's scraper first (~30-60 min cold, in ../../hydration-node/target). Needs network.
# `just slim="--slim" scrape` for the slim variant.
scrape at="" uri="wss://rpc.hydradx.cloud:443":
    cd ../../hydration-node && {{env}} cargo build --release -p scraper
    mkdir -p data/scrape
    ../../hydration-node/target/release/scraper save-storage --uri {{uri}} {{ if at != "" { "--at " + at } else { "" } }} {{slim}} --path data/scrape
    echo "scraped mainnet{{ if at != "" { " @ " + at } else { " (latest finalized)" } }} -> data/scrape/SNAPSHOT; now: just snapshot"

# Patch a scraped snapshot into the fuzzer's starting state data/SNAPSHOT.
# Default source: data/scrape/SNAPSHOT from `just scrape`; falls back to the node repo's committed
# integration-tests/snapshots/ice/SNAPSHOT_uni (April 2026) when no scrape exists.
snapshot src="" dst="data/SNAPSHOT": build
    src="{{src}}"; [ -n "$src" ] || { [ -f data/scrape/SNAPSHOT ] && src=data/scrape/SNAPSHOT || src=../../hydration-node/integration-tests/snapshots/ice/SNAPSHOT_uni; }; \
    echo "source: $src"; \
    {{noprof}} ./target/release/hydration-fuzz-snapshot "$src" {{dst}}

# Harness self-tests against data/SNAPSHOT
test:
    {{env}} cargo test --release -p hydration-fuzz-harness

# Seeded soak run without AFL, e.g. `just soak 600`
soak seconds="300":
    FUZZ_SECONDS={{seconds}} {{fuzz_env}} {{noprof}} ./target/release/hydration-fuzz-soak

# Replay one or more inputs verbosely (soak findings or AFL crash files)
replay +files:
    {{fuzz_env}} {{noprof}} ./target/release/hydration-fuzz-soak replay "$@"

# Generate N seed inputs for AFL
seeds n="64": build
    {{noprof}} ./target/release/hydration-fuzz-soak seeds targets/runtime/seeds {{n}}

# Start AFL fuzzing (resumes an existing queue; see `just restart` for a clean start). -g 768 keeps inputs
# >= ~12 actions (AFL otherwise drifts to 3-4 actions per input); -G 4096 caps at the 48-action bound.
fuzz jobs="4":
    cd targets/runtime && {{fuzz_env}} {{afl_build_env}} {{afl_env}} \
        cargo ziggy fuzz --no-honggfuzz --release -j {{jobs}} -t 22 -g 768 -G 4096 -i seeds

# Park the old queue/corpus so the next `just fuzz` starts from the seeds (no long dry run)
restart:
    ts=$(date +%s); \
    [ -d {{out}}/afl ] && mv {{out}}/afl {{out}}/afl.$ts || true; \
    rm -rf {{out}}/corpus; \
    [ -d targets/runtime/seeds ] || just seeds; \
    echo "queue parked as afl.$ts; now: just fuzz"

# Merge every instance's queue + the shared corpus into one dir, deduplicated by content
merge-corpus dst="corpus_all":
    mkdir -p {{dst}}; n=0; \
    for f in {{out}}/afl/*/queue/* {{out}}/afl.*/*/queue/* {{out}}/corpus/*; do \
        [ -f "$f" ] || continue; h=$(sha1sum "$f" | cut -c1-16); \
        [ -e "{{dst}}/$h" ] || { cp "$f" "{{dst}}/$h"; n=$((n+1)); }; \
    done; echo "$(ls {{dst}} | wc -l) unique inputs in {{dst}} ($n added)"

# Coverage-preserving minimization (afl-cmin's algorithm via scripts/cmin.sh) of a merged corpus
# -> targets/runtime/seeds_min. ~1 s per input per job; JOBS x 1.4 GB RAM (one snapshot per showmap).
minimize src="corpus_all" jobs="8":
    rm -rf targets/runtime/seeds_min
    {{fuzz_env}} {{afl_env}} ./scripts/cmin.sh {{src}} targets/runtime/seeds_min {{jobs}}

# End-of-run rotation, after stopping the fuzzer: triage every crash dir, merge + minimise all queues into the seed
# set, coverage report of the minimised set, archive queues+crashes to archive/run-<ts>.tgz, drop .profraw litter.
# Afterwards: `just fuzz 16`. Hours for a big run (minimise + cover replay every input once).
rotate jobs="8":
    ts=$(date +%s); mkdir -p archive; \
    for d in {{out}}/crashes/*/; do [ -d "$d" ] && TRIAGE_LOG=archive/triage-$ts.log just triage "$d" || true; done; \
    echo "--- triage log: archive/triage-$ts.log"; \
    just merge-corpus corpus_all; \
    just minimize corpus_all {{jobs}}; \
    just restart; \
    rm -rf targets/runtime/seeds && cp -r targets/runtime/seeds_min targets/runtime/seeds; \
    just stats-corpus targets/runtime/seeds; \
    JOBS={{jobs}} just cover targets/runtime/seeds; \
    tar czf archive/run-$ts.tgz -C {{out}} $(cd {{out}} && ls -d afl.* crashes 2>/dev/null) && rm -rf {{out}}/afl.* {{out}}/crashes; \
    find . ../../hydration-node -name '*.profraw' -delete; \
    echo "ready: $(ls targets/runtime/seeds | wc -l) seeds, archive/run-$ts.tgz, archive/triage-$ts.log; now: just fuzz 16"

# Histogram of action kinds in a corpus (decode only), default: the live AFL corpus
stats-corpus dir=(out + "/corpus"):
    {{noprof}} ./target/release/hydration-fuzz-soak stats {{dir}}

# One-screen fuzzer status (AFL progress, corpus action mix, last coverage); `just notify-status` sends it
status:
    ./scripts/monitor-status.sh

notify-status:
    ./scripts/monitor-status.sh | DISCORD_WEBHOOK_FILE=../.env ./scripts/notify-discord.sh

# Monitor pre-check: exit 0 if there are untriaged crash files or the fuzzer looks dead/stalled, else 1
gate:
    ./scripts/monitor-gate.sh

# Live stats of the running AFL instances
stats:
    grep -E "run_time|execs_per_sec|corpus_count|saved_crashes|stability" {{out}}/afl/*/fuzzer_stats | paste - - - - -

# Replay every crash in DIR (default: newest crash dir), one line each + histogram
triage dir="":
    {{fuzz_env}} ./scripts/triage.sh {{dir}}

# Line coverage of the corpus through the AFL binary -> targets/runtime/output/coverage/
cover corpus="":
    ./scripts/coverage.sh {{corpus}}
